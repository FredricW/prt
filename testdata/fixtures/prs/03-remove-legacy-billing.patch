From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bob <bob@acme.example>
Date: Fri, 9 Oct 2026 11:45:00 +0000
Subject: [PATCH] chore(billing): remove legacy finance export and dead helpers

Finance moved to the ledger API in 2024 and the 2023 reconciliation is
closed. Nothing references these any more:

- legacy.go (LegacyExport, WriteLegacyCSV, parseLegacyDate)
- renumberLegacy in invoice.go
- legacyTaxCents in tax.go
---
 server/internal/billing/invoice.go | 13 -------
 server/internal/billing/legacy.go  | 57 ------------------------------
 server/internal/billing/tax.go     |  8 -----
 3 files changed, 78 deletions(-)
 delete mode 100644 server/internal/billing/legacy.go

diff --git a/server/internal/billing/invoice.go b/server/internal/billing/invoice.go
index 536cc83..8dee0be 100644
--- a/server/internal/billing/invoice.go
+++ b/server/internal/billing/invoice.go
@@ -103,19 +103,6 @@ func (s *Service) Issue(orgID, country string, netCents int64, now time.Time) (I
 	return inv, s.ledger.Save(inv)
 }
 
-// renumberLegacy rewrites pre-2024 invoice numbers to the YYYY-NNNN scheme.
-// Deprecated: the migration ran in March 2024; nothing calls this any more.
-func renumberLegacy(invs []Invoice) []Invoice {
-	out := make([]Invoice, len(invs))
-	for i, inv := range invs {
-		if inv.IssuedAt.Year() < 2024 {
-			inv.Number = fmt.Sprintf("%d-%04d", inv.IssuedAt.Year(), i+1)
-		}
-		out[i] = inv
-	}
-	return out
-}
-
 // Routes mounts the billing endpoints.
 func Routes(s *Service) http.Handler {
 	r := chi.NewRouter()
diff --git a/server/internal/billing/legacy.go b/server/internal/billing/legacy.go
deleted file mode 100644
index 5914f5a..0000000
--- a/server/internal/billing/legacy.go
+++ /dev/null
@@ -1,57 +0,0 @@
-package billing
-
-import (
-	"encoding/csv"
-	"fmt"
-	"io"
-	"strconv"
-	"time"
-)
-
-// LegacyExport is the CSV row format the old finance system imported.
-//
-// Deprecated: finance moved to the ledger API in 2024; no route serves this.
-type LegacyExport struct {
-	Number  string
-	OrgID   string
-	Amount  string
-	Issued  string
-	IsPaid  bool
-	Comment string
-}
-
-// toLegacy converts an Invoice to the legacy export row.
-func toLegacy(inv Invoice) LegacyExport {
-	return LegacyExport{
-		Number: inv.Number,
-		OrgID:  inv.OrgID,
-		Amount: fmt.Sprintf("%.2f", float64(inv.AmountCents)/100),
-		Issued: inv.IssuedAt.Format("02.01.2006"),
-		IsPaid: inv.Status == StatusPaid,
-	}
-}
-
-// WriteLegacyCSV writes invoices in the legacy finance CSV format.
-//
-// Deprecated: see LegacyExport.
-func WriteLegacyCSV(w io.Writer, invs []Invoice) error {
-	cw := csv.NewWriter(w)
-	cw.Comma = ';'
-	if err := cw.Write([]string{"nr", "org", "amount", "issued", "paid", "comment"}); err != nil {
-		return err
-	}
-	for _, inv := range invs {
-		row := toLegacy(inv)
-		rec := []string{row.Number, row.OrgID, row.Amount, row.Issued, strconv.FormatBool(row.IsPaid), row.Comment}
-		if err := cw.Write(rec); err != nil {
-			return fmt.Errorf("legacy csv %s: %w", inv.Number, err)
-		}
-	}
-	cw.Flush()
-	return cw.Error()
-}
-
-// parseLegacyDate parses the dd.mm.yyyy dates the old system produced.
-func parseLegacyDate(s string) (time.Time, error) {
-	return time.Parse("02.01.2006", s)
-}
diff --git a/server/internal/billing/tax.go b/server/internal/billing/tax.go
index cf35524..047aad8 100644
--- a/server/internal/billing/tax.go
+++ b/server/internal/billing/tax.go
@@ -1,7 +1,6 @@
 package billing
 
 import (
-	"math"
 	"strings"
 )
 
@@ -23,10 +22,3 @@ func TaxCents(country string, netCents int64) int64 {
 	}
 	return (netCents*bp + 5000) / 10000
 }
-
-// legacyTaxCents is the float-based calculation used before basis points.
-// Deprecated: kept for the 2023 reconciliation, which has been closed.
-func legacyTaxCents(country string, netCents int64) int64 {
-	rate := float64(vatRates[strings.ToUpper(country)]) / 10000
-	return int64(math.Round(float64(netCents) * rate))
-}
