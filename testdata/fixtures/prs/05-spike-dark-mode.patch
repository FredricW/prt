@@ -0,0 +1,19 @@
+import { useEffect, useState } from "react";
+
+type Theme = "light" | "dark";
+
+// TODO: respect prefers-color-scheme before anything is stored
+export function ThemeToggle() {
+  const [theme, setTheme] = useState<Theme>(() => (localStorage.getItem("portal.theme") as Theme) ?? "light");
+
+  useEffect(() => {
+    document.documentElement.dataset.theme = theme;
+    localStorage.setItem("portal.theme", theme);
+  }, [theme]);
+
+  return (
+    <button aria-label="Toggle dark mode" onClick={() => setTheme(theme === "dark" ? "light" : "dark")}>
+      {theme === "dark" ? "☀" : "☾"}
+    </button>
+  );
+}
