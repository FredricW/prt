+func Routes(store Store, prefs PreferencesStore, withPreferences bool) http.Handler {
 	r := chi.NewRouter()
 	r.Get("/{id}", func(w http.ResponseWriter, req *http.Request) {
 		u, err := store.Get(chi.URLParam(req, "id"))
@@ -96,6 +97,10 @@ func Routes(store Store) http.Handler {
 		}
 		writeJSON(w, http.StatusOK, toResponse(u))
 	})
+	if withPreferences {
+		r.Get("/{id}/preferences", getPreferences(prefs))
+		r.Put("/{id}/preferences", putPreferences(prefs))
+	}
 	return r
 }
 
