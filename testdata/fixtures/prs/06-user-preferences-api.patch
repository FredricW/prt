diff --git a/web/src/utils/flags.ts b/web/src/utils/flags.ts
new file mode 100644
index 0000000..6fc9896
--- /dev/null
+++ b/web/src/utils/flags.ts
@@ -0,0 +1,13 @@
+// Feature flags, injected by the server as window.__PORTAL_FLAGS__.
+type FlagMap = Record<string, boolean>;
+
+function loadFlags(): FlagMap {
+  const injected = (globalThis as { __PORTAL_FLAGS__?: FlagMap }).__PORTAL_FLAGS__;
+  return injected ?? {};
+}
+
+const flags = loadFlags();
+
+export function isEnabled(name: string): boolean {
+  return flags[name] === true;
+}
