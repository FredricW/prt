--- /dev/null
+++ b/web/src/api/preferences.ts
@@ -0,0 +1,16 @@
+import { fetchJSON } from "./client";
+
+export interface Preferences {
+  userId: string;
+  theme: "system" | "light" | "dark";
+  emailDigest: "never" | "daily" | "weekly";
+  updatedAt: string;
+}
+
+export async function getPreferences(userId: string): Promise<Preferences> {
+  return fetchJSON<Preferences>(`/users/${encodeURIComponent(userId)}/preferences`);
+}
+
+export async function savePreferences(p: Preferences): Promise<Preferences> {
+  return fetchJSON<Preferences>(`/users/${encodeURIComponent(p.userId)}/preferences`, { method: "PUT", body: p });
+}
