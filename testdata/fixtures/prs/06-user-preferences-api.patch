+
+func TestPreferencesDefaults(t *testing.T) {
+	srv := httptest.NewServer(Routes(NewMemoryStore(), NewMemoryPreferences(), true))
+	defer srv.Close()
+
+	res, err := http.Get(srv.URL + "/u1/preferences")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	var p Preferences
+	if err := json.NewDecoder(res.Body).Decode(&p); err != nil {
+		t.Fatal(err)
+	}
+	if p.UserID != "u1" || p.Theme != "system" || p.EmailDigest != "weekly" {
+		t.Fatalf("unexpected preferences %+v", p)
+	}
+}
diff --git a/server/migrations/20261010_user_preferences.sql b/server/migrations/20261010_user_preferences.sql
new file mode 100644
index 0000000..8afdf53
--- /dev/null
+++ b/server/migrations/20261010_user_preferences.sql
@@ -0,0 +1,14 @@
+-- User preferences (theme, email digest) and the profile avatar URL.
+-- users.legacy_theme has not been written since the 2025 redesign.
+
+CREATE TABLE user_preferences (
+    user_id      TEXT PRIMARY KEY REFERENCES users (id) ON DELETE CASCADE,
+    theme        TEXT NOT NULL DEFAULT 'system',
+    email_digest TEXT NOT NULL DEFAULT 'weekly',
+    updated_at   TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
+CREATE INDEX user_preferences_theme_idx ON user_preferences (theme);
+
+ALTER TABLE users ADD COLUMN avatar_url TEXT;
+ALTER TABLE users DROP COLUMN legacy_theme;
