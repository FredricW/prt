diff --git a/server/internal/users/preferences.go b/server/internal/users/preferences.go
new file mode 100644
index 0000000..120b43b
--- /dev/null
+++ b/server/internal/users/preferences.go
@@ -0,0 +1,89 @@
+package users
+
+import (
+	"encoding/json"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// Preferences are a user's UI settings (table user_preferences).
+type Preferences struct {
+	UserID      string    `json:"userId"`
+	Theme       string    `json:"theme"`
+	EmailDigest string    `json:"emailDigest"`
+	UpdatedAt   time.Time `json:"updatedAt"`
+}
+
+// PreferencesStore reads and writes preferences.
+type PreferencesStore interface {
+	Get(userID string) (Preferences, error)
+	Put(p Preferences) error
+}
+
+// MemoryPreferences is an in-memory PreferencesStore for development.
+type MemoryPreferences struct {
+	mu    sync.Mutex
+	prefs map[string]Preferences
+}
+
+// NewMemoryPreferences returns an empty MemoryPreferences.
+func NewMemoryPreferences() *MemoryPreferences {
+	return &MemoryPreferences{prefs: map[string]Preferences{}}
+}
+
+// Get returns the stored preferences, or the defaults for a user who never
+// saved any.
+func (m *MemoryPreferences) Get(userID string) (Preferences, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	p, ok := m.prefs[userID]
+	if !ok {
+		return Preferences{UserID: userID, Theme: "system", EmailDigest: "weekly"}, nil
+	}
+	return p, nil
+}
+
+// Put stores p.
+func (m *MemoryPreferences) Put(p Preferences) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.prefs[p.UserID] = p
+	return nil
+}
+
+var themes = map[string]bool{"system": true, "light": true, "dark": true}
+
+func getPreferences(prefs PreferencesStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, req *http.Request) {
+		p, err := prefs.Get(chi.URLParam(req, "id"))
+		if err != nil {
+			writeError(w, http.StatusInternalServerError, "internal", err.Error())
+			return
+		}
+		writeJSON(w, http.StatusOK, p)
+	}
+}
+
+func putPreferences(prefs PreferencesStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, req *http.Request) {
+		var p Preferences
+		if err := json.NewDecoder(req.Body).Decode(&p); err != nil {
+			writeError(w, http.StatusBadRequest, "bad_request", "invalid JSON")
+			return
+		}
+		if !themes[p.Theme] {
+			writeError(w, http.StatusBadRequest, "bad_request", "unknown theme")
+			return
+		}
+		p.UserID = chi.URLParam(req, "id")
+		p.UpdatedAt = time.Now().UTC()
+		if err := prefs.Put(p); err != nil {
+			writeError(w, http.StatusInternalServerError, "internal", err.Error())
+			return
+		}
+		writeJSON(w, http.StatusOK, p)
+	}
+}
