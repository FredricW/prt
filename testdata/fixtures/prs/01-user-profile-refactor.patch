+export function ProfileHeader({ user, stale, onRefresh }: Props) {
+  return (
+    <header className="profile__header">
+      <Avatar name={user.displayName} url={user.avatarUrl} size={64} />
+      <div>
+        <h1>{user.displayName}</h1>
+        <p className="muted">
+          {user.email} · member since {formatDate(user.createdAt)}
+        </p>
+        {user.team && (
+          <p>
+            Team <a href={`/teams/${user.team.id}`}>{user.team.name}</a>
+          </p>
+        )}
+      </div>
+      <button className="link" onClick={onRefresh} title={stale ? "Profile may be out of date" : "Reload profile"}>
+        {stale ? "Out of date — refresh" : "Refresh"}
+      </button>
+    </header>
+  );
+}
