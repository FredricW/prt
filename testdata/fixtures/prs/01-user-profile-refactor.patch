@@ -0,0 +1,25 @@
+import { useState } from "react";
+
+import { initials } from "../utils/format";
+
+interface Props {
+  name: string;
+  url?: string | null;
+  size?: number;
+}
+
+// Avatar shows the user's picture, falling back to initials when there is
+// none or it fails to load.
+export function Avatar({ name, url, size = 32 }: Props) {
+  const [broken, setBroken] = useState(false);
+  const style = { width: size, height: size };
+
+  if (!url || broken) {
+    return (
+      <span className="avatar" style={style} aria-label={name}>
+        {initials(name)}
+      </span>
+    );
+  }
+  return <img className="avatar" style={style} src={url} alt={name} onError={() => setBroken(true)} />;
+}
