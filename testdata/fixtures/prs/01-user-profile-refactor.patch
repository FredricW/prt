@@ -0,0 +1,56 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import * as client from "../api/client";
+import { clearProfileCache, loadProfile, primeProfile, PROFILE_TTL_MS } from "../hooks/useProfileCache";
+
+const ada = {
+  id: "u1",
+  email: "ada@example.com",
+  displayName: "Ada",
+  teamId: null,
+  createdAt: "2025-03-01T12:00:00Z",
+} satisfies client.User;
+
+beforeEach(() => {
+  clearProfileCache();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+describe("loadProfile", () => {
+  it("fetches once and serves later calls from cache", async () => {
+    const spy = vi.spyOn(client, "getUser").mockResolvedValue(ada);
+    await loadProfile("u1");
+    await loadProfile("u1");
+    expect(spy).toHaveBeenCalledTimes(1);
+    expect(spy).toHaveBeenCalledWith("u1", { include: ["team", "avatar"], fresh: false });
+  });
+
+  it("shares one request between concurrent callers", async () => {
+    const spy = vi.spyOn(client, "getUser").mockResolvedValue(ada);
+    const [a, b] = await Promise.all([loadProfile("u1"), loadProfile("u1")]);
+    expect(a).toBe(b);
+    expect(spy).toHaveBeenCalledTimes(1);
+  });
+
+  it("refetches after the TTL", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(0);
+    primeProfile(ada, 0);
+    const spy = vi.spyOn(client, "getUser").mockResolvedValue({ ...ada, displayName: "Ada L." });
+    vi.setSystemTime(PROFILE_TTL_MS + 1);
+    const user = await loadProfile("u1");
+    expect(user.displayName).toBe("Ada L.");
+    expect(spy).toHaveBeenCalledTimes(1);
+  });
+
+  it("bypasses the cache when fresh is set", async () => {
+    primeProfile(ada);
+    const spy = vi.spyOn(client, "getUser").mockResolvedValue(ada);
+    await loadProfile("u1", true);
+    expect(spy).toHaveBeenCalledWith("u1", { include: ["team", "avatar"], fresh: true });
+  });
+});
