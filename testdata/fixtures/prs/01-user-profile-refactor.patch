new file mode 100644
index 0000000..7ed02b3
--- /dev/null
+++ b/web/src/hooks/useProfileCache.ts
@@ -0,0 +1,81 @@
+import { useCallback, useEffect, useState } from "react";
+
+import { getUser, type User } from "../api/client";
+
+// How long a cached profile is served without revalidating.
+export const PROFILE_TTL_MS = 5 * 60 * 1000;
+
+interface Entry {
+  user: User;
+  fetchedAt: number;
+}
+
+const cache = new Map<string, Entry>();
+const inflight = new Map<string, Promise<User>>();
+
+export function clearProfileCache(): void {
+  cache.clear();
+  inflight.clear();
+}
+
+export function primeProfile(user: User, now = Date.now()): void {
+  cache.set(user.id, { user, fetchedAt: now });
+}
+
+function isFresh(entry: Entry | undefined, now: number): entry is Entry {
+  return entry !== undefined && now - entry.fetchedAt < PROFILE_TTL_MS;
+}
+
+// loadProfile returns the cached profile when fresh, otherwise fetches it,
+// sharing one request between concurrent callers for the same id.
+export async function loadProfile(id: string, fresh = false): Promise<User> {
+  const now = Date.now();
+  const hit = cache.get(id);
+  if (!fresh && isFresh(hit, now)) {
+    return hit.user;
+  }
+  const pending = inflight.get(id);
+  if (pending) {
+    return pending;
+  }
+  const req = getUser(id, { include: ["team", "avatar"], fresh })
+    .then((user) => {
+      cache.set(id, { user, fetchedAt: Date.now() });
+      return user;
+    })
+    .finally(() => inflight.delete(id));
+  inflight.set(id, req);
+  return req;
+}
+
+export interface ProfileCacheState {
+  profile: User | null;
+  loading: boolean;
+  stale: boolean;
+  refresh: () => void;
+}
+
+// useProfileCache serves the cached profile immediately (stale-while-
+// revalidate) and refreshes it in the background when it is older than the TTL.
+export function useProfileCache(id: string): ProfileCacheState {
+  const cached = cache.get(id);
+  const [profile, setProfile] = useState<User | null>(cached?.user ?? null);
+  const [loading, setLoading] = useState(!cached);
+  const [stale, setStale] = useState(cached !== undefined && !isFresh(cached, Date.now()));
+  const [nonce, setNonce] = useState(0);
+
+  useEffect(() => {
+    setLoading(true);
