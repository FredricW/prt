  "text": "server/internal/users/preferences.go\nfunc putPreferences(prefs PreferencesStore) http.HandlerFunc\n+func putPreferences(prefs PreferencesStore) http.HandlerFunc {\n+\treturn func(w http.ResponseWriter, req *http.Request) {\n+\t\tvar p Preferences\n+\t\tif err := json.NewDecoder(req.Body).Decode(\u0026p); err != nil {\n+\t\t\twriteError(w, http.StatusBadRequest, \"bad_request\", \"invalid JSON\")\n+\t\t\treturn\n+\t\t}\n+\t\tif !themes[p.Theme] {\n+\t\t\twriteError(w, http.StatusBadRequest, \"bad_request\", \"unknown theme\")\n+\t\t\treturn\n+\t\t}\n+\t\tp.UserID = chi.URLParam(req, \"id\")\n+\t\tp.UpdatedAt = time.Now().UTC()\n+\t\tif err := prefs.Put(p); err != nil {\n+\t\t\twriteError(w, http.StatusInternalServerError, \"internal\", err.Error())\n+\t\t\treturn\n+\t\t}\n+\t\twriteJSON(w, http.StatusOK, p)\n+\t}\n+}",
