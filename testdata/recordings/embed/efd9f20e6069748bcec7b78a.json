  "text": "web/src/__tests__/useProfileCache.test.ts\n\n+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";\n+\n+import * as client from \"../api/client\";\n+import { clearProfileCache, loadProfile, primeProfile, PROFILE_TTL_MS } from \"../hooks/useProfileCache\";\n+\n+const ada = {\n+  id: \"u1\",\n+  email: \"ada@example.com\",\n+  displayName: \"Ada\",\n+  teamId: null,\n+  createdAt: \"2025-03-01T12:00:00Z\",\n+} satisfies client.User;\n+\n+beforeEach(() =\u003e {\n+  clearProfileCache();\n+});\n+\n+afterEach(() =\u003e {\n+  vi.useRealTimers();\n+  vi.restoreAllMocks();\n+});\n+\n+describe(\"loadProfile\", () =\u003e {\n+  it(\"fetches once and serves later calls from cache\", async () =\u003e {\n+    const spy = vi.spyOn(client, \"getUser\").mockResolvedValue(ada);\n+    await loadProfile(\"u1\");\n+    await loadProfile(\"u1\");\n+    expect(spy).toHaveBeenCalledTimes(1);\n+    expect(spy).toHaveBeenCalledWith(\"u1\", { include: [\"team\", \"avatar\"], fresh: false });\n+  });\n+\n+  it(\"shares one request between concurrent callers\", async () =\u003e {\n+    const spy = vi.spyOn(client, \"getUser\").mockResolvedValue(ada);\n+    const [a, b] = await Promise.all([loadProfile(\"u1\"), loadProfile(\"u1\")]);\n+    expect(a).toBe(b);\n+    expect(spy).toHaveBeenCalledTimes(1);\n+  });\n+\n+  it(\"refetches after the TTL\", async () =\u003e {\n+    vi.useFakeTimers();\n+    vi.setSystemTime(0);\n+    primeProfile(ada, 0);\n+    const spy = vi.spyOn(client, \"getUser\").mockResolvedValue({ ...ada, displayName: \"Ada L.\" });\n+    vi.setSystemTime(PROFILE_TTL_MS + 1);\n+    const user = await loadProfile(\"u1\");\n+    expect(user.displayName).toBe(\"Ada L.\");\n+    expect(spy).toHaveBeenCalledTimes(1);\n+  });\n+\n+  it(\"bypasses the cache when fresh is set\", async () =\u003e {\n+    primeProfile(ada);\n+    const spy = vi.spyOn(client, \"getUser\").mockResolvedValue(ada);\n+    await loadProfile(\"u1\", true);\n+    expect(spy).toHaveBeenCalledWith(\"u1\", { include: [\"team\", \"avatar\"], fresh: true });\n+  });\n+});",
