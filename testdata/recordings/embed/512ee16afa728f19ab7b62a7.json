  "text": "web/src/hooks/useProfileCache.ts\nexport async function loadProfile(id: string, fresh = false): Promise\u003cUser\u003e\n+// loadProfile returns the cached profile when fresh, otherwise fetches it,\n+// sharing one request between concurrent callers for the same id.\n+export async function loadProfile(id: string, fresh = false): Promise\u003cUser\u003e {\n+  const now = Date.now();\n+  const hit = cache.get(id);\n+  if (!fresh \u0026\u0026 isFresh(hit, now)) {\n+    return hit.user;\n+  }\n+  const pending = inflight.get(id);\n+  if (pending) {\n+    return pending;\n+  }\n+  const req = getUser(id, { include: [\"team\", \"avatar\"], fresh })\n+    .then((user) =\u003e {\n+      cache.set(id, { user, fetchedAt: Date.now() });\n+      return user;\n+    })\n+    .finally(() =\u003e inflight.delete(id));\n+  inflight.set(id, req);\n+  return req;\n+}\n+",
