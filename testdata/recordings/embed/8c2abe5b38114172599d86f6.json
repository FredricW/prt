  "text": "server/cmd/api/main.go\nfunc main()\n+\tprefs := users.NewMemoryPreferences()\n-\t\tr.Get(\"/health\", func(w http.ResponseWriter, _ *http.Request) {\n-\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n-\t\t\t_, _ = w.Write([]byte(`{\"status\":\"ok\",\"version\":\"0.14.2\"}`))\n-\t\t})\n-\t\tr.Mount(\"/users\", users.Routes(store))\n+\t\tr.Mount(\"/users\", users.Routes(store, prefs, os.Getenv(\"PORTAL_PREFERENCES_API\") == \"on\"))\n+\t// Health checks moved off the public API to the ops listener, which the\n+\t// load balancer probes.\n+\tops := http.NewServeMux()\n+\tops.HandleFunc(\"GET /healthz\", func(w http.ResponseWriter, _ *http.Request) {\n+\t\tw.WriteHeader(http.StatusNoContent)\n+\t})\n+\topsAddr := os.Getenv(\"PORTAL_OPS_ADDR\")\n+\tif opsAddr == \"\" {\n+\t\topsAddr = \":9090\"\n+\t}\n+\tgo func() {\n+\t\tif err := http.ListenAndServe(opsAddr, ops); err != nil {\n+\t\t\tlogger.Error(\"ops listener stopped\", \"err\", err)\n+\t\t}\n+\t}()\n+",
