  "text": "web/src/hooks/useProfileCache.ts\nexport function useProfileCache(id: string): ProfileCacheState\n+// useProfileCache serves the cached profile immediately (stale-while-\n+// revalidate) and refreshes it in the background when it is older than the TTL.\n+export function useProfileCache(id: string): ProfileCacheState {\n+  const cached = cache.get(id);\n+  const [profile, setProfile] = useState\u003cUser | null\u003e(cached?.user ?? null);\n+  const [loading, setLoading] = useState(!cached);\n+  const [stale, setStale] = useState(cached !== undefined \u0026\u0026 !isFresh(cached, Date.now()));\n+  const [nonce, setNonce] = useState(0);\n+\n+  useEffect(() =\u003e {\n+    setLoading(true);\n+    loadProfile(id, nonce \u003e 0)\n+      .then((user) =\u003e {\n+        setProfile(user);\n+        setStale(false);\n+        setLoading(false);\n+      })\n+      .catch(() =\u003e {});\n+  }, [id, nonce]);\n+\n+  const refresh = useCallback(() =\u003e setNonce((n) =\u003e n + 1), []);\n+\n+  return { profile, loading, stale, refresh };\n+}",
