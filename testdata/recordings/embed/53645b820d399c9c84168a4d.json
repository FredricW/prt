  "text": "web/src/components/Avatar.tsx\nexport function Avatar({ name, url, size = 32 }: Props)\n+// Avatar shows the user's picture, falling back to initials when there is\n+// none or it fails to load.\n+export function Avatar({ name, url, size = 32 }: Props) {\n+  const [broken, setBroken] = useState(false);\n+  const style = { width: size, height: size };\n+\n+  if (!url || broken) {\n+    return (\n+      \u003cspan className=\"avatar\" style={style} aria-label={name}\u003e\n+        {initials(name)}\n+      \u003c/span\u003e\n+    );\n+  }\n+  return \u003cimg className=\"avatar\" style={style} src={url} alt={name} onError={() =\u003e setBroken(true)} /\u003e;\n+}",
