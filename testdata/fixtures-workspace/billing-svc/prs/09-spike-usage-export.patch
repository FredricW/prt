+// Package export writes billing data for finance.
+//
+// Spike: CSV only, no paging, no auth. Not for merging as is.
+package export
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+	"time"
+
+	"example.com/billing-svc/internal/invoice"
+)
+
+// WriteUsageCSV writes one row per invoice with a header row first.
+func WriteUsageCSV(w io.Writer, invs []invoice.Invoice) error {
+	cw := csv.NewWriter(w)
+	header := []string{"id", "customer_id", "currency", "amount_cents", "status", "issued_at"}
+	if err := cw.Write(header); err != nil {
+		return err
+	}
+	for _, inv := range invs {
+		row := []string{
+			inv.ID,
+			inv.CustomerID,
+			inv.Currency,
+			strconv.FormatInt(inv.AmountCents, 10),
+			string(inv.Status),
+			inv.IssuedAt.Format(time.RFC3339),
+		}
+		if err := cw.Write(row); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
