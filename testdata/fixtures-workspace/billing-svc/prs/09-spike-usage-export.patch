+// All returns every invoice, ordered by id.
+// TODO: page this before the store grows past a few thousand invoices.
+func (s *Store) All() []Invoice {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := make([]Invoice, 0, len(s.byID))
+	for _, inv := range s.byID {
+		out = append(out, inv)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out
+}
